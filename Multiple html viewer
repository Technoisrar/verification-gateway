<body>

<main class="wrapper">
  <section class="hero">
    <div class="badge"><i></i>OFFICIAL PLATFORM TOOL</div>
    <h1>Israr Lab HTML Viewer</h1>
    <p style="margin-top:8px;color:var(--muted);font-size:12px;line-height:1.6;">Secure, private online multiple HTML viewer with 9-dot pattern lock vault and local backup storage.</p>
  </section>

  <section class="panel">
    <div id="homeView">
      <div class="app-header" id="mainHeaderSection">
        <div class="header-btn-row">
          <button class="hdr-btn theme-btn" onclick="applyVipGradientThemeMain()"><i class="fas fa-palette"></i> Theme</button>
          <button class="hdr-btn" onclick="openMainMenuModal()"><i class="fas fa-bars"></i> Menu</button>
          <button class="hdr-btn" onclick="openCategorySettings()"><i class="fas fa-cog"></i> Settings</button>
          <button class="hdr-btn lock-btn" onclick="openLockPromptModal()"><i class="fas fa-lock"></i> Vault</button>
        </div>
      </div>

      <div class="top-action-bar">
        <button class="top-btn" onclick="openRecoveryView()"><i class="fas fa-trash-restore"></i> Recovery</button>
        <button class="top-btn" onclick="openBackupView()"><i class="fas fa-database"></i> Backup</button>
        <button class="top-btn" id="delMarkBtn" onclick="toggleMarkDeleteMode()"><i class="fas fa-check-square"></i> Mark Delete</button>
      </div>

      <div class="category-bar-wrapper">
        <div class="category-scroll-area" id="categoryBarContainer">
          <button class="top-btn" onclick="openNewCategoryModal()" style="background:var(--cyan);color:#03050b;border:none;margin-right:4px;font-weight:700;"><i class="fas fa-plus"></i> Category</button>
          <div class="cat-chip active" onclick="filterByCategory('All', this)">All HTML Codes</div>
        </div>
      </div>

      <div class="notes-container" id="notesContainer">
        <div class="empty-notes"><p>कोई HTML कोड नहीं है। नया कोड जोड़ने के लिए (+) बटन दबाएं।</p></div>
      </div>
      <button class="fab" id="mainFabBtn" onclick="openEditor()"><i class="fas fa-plus"></i></button>
    </div>
  </section>

  <!-- FULL SCREEN INTERACTIVE HTML VIEW -->
  <div id="fullHtmlView">
    <div class="recovery-header">
      <button class="top-btn" onclick="closeFullHtmlView()" style="background:var(--cyan); color:#03050b; font-weight:700;"><i class="fas fa-arrow-left"></i> Back to Home</button>
      <span id="fullHtmlTitle" style="font-weight:700; font-size:14px; color:#fff;">HTML Preview</span>
      <button class="top-btn" onclick="copyCurrentFullCode()"><i class="fas fa-copy"></i> Copy Code</button>
    </div>
    <div style="flex:1; background:#ffffff; position:relative; overflow:hidden;">
      <iframe id="fullHtmlIframe" style="width:100%; height:100%; border:none;"></iframe>
    </div>
  </div>

  <!-- Modals & SubViews -->
  <div id="mainMenuModal">
    <div class="modal-content" style="width: 310px;">
      <div class="modal-title">Main Menu & Sorting</div>
      <div class="modal-cat-item" onclick="setMenuGridViewMode('grid')">🔲 Grid View (2 Columns)</div>
      <div class="modal-cat-item" onclick="setMenuGridViewMode('list')">📋 List View (1 Column)</div>
      <div class="modal-btn-group"><button class="modal-btn-cancel" onclick="closeMainMenuModal()" style="width:100%;">Close</button></div>
    </div>
  </div>

  <!-- Lock Prompt Modal with Fixed Layout -->
  <div id="lockPromptModal">
    <div class="modal-content">
      <div class="modal-title">Secure Vault Unlock</div>
      <div style="font-size:11px;color:var(--muted);text-align:center;">पैटर्न स्वाइप करें (डिफ़ॉल्ट: Z आकार 1-2-3-5-7-8-9):</div>
