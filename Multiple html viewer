<script>
let notes = JSON.parse(localStorage.getItem('israr_html_notes')) || [];
let lockedNotes = JSON.parse(localStorage.getItem('israr_html_locked')) || [];
let trashNotes = JSON.parse(localStorage.getItem('israr_html_trash')) || [];
let categories = JSON.parse(localStorage.getItem('israr_html_cats')) || ['General', 'UI Buttons', 'Scripts'];
let currentCategoryFilter = 'All';
let editingIndex = null;
let autoSaveTimer = null;
let clockInterval = null;
let currentThemeIndex = parseInt(localStorage.getItem('israr_html_theme')) || 0;
let userSecretPattern = localStorage.getItem('israr_html_pattern') || '1235789';
let isListView = false;
let isMarkDeleteMode = false;
let selectedNoteIndexForContext = null;
let currentCaptchaText = '';

const vipThemes = [
  { bg: 'radial-gradient(circle at 10% 0%,rgba(45,210,255,.12),transparent 28%),radial-gradient(circle at 90% 10%,rgba(125,76,255,.14),transparent 30%),#03050b', panel: 'rgba(66,232,255,.25)', home: 'linear-gradient(145deg,#0a1220,#060d18)', accent: '#42e8ff' },
  { bg: 'radial-gradient(circle at 20% 0%,rgba(140,108,255,.18),transparent 30%),radial-gradient(circle at 80% 80%,rgba(76,227,168,.08),transparent 35%),#0a0614', panel: 'rgba(140,108,255,.35)', home: 'linear-gradient(145deg,#120f24,#0a0818)', accent: '#8c6cff' }
];

function saveData() {
  if (notes.length > 200) notes = notes.slice(0, 200);
  localStorage.setItem('israr_html_notes', JSON.stringify(notes));
  localStorage.setItem('israr_html_locked', JSON.stringify(lockedNotes));
  localStorage.setItem('israr_html_trash', JSON.stringify(trashNotes));
  localStorage.setItem('israr_html_cats', JSON.stringify(categories));
  localStorage.setItem('israr_html_theme', currentThemeIndex);
  localStorage.setItem('israr_html_pattern', userSecretPattern);
}

function applyThemeByIndex(idx) {
  const t = vipThemes[idx % vipThemes.length];
  if (!t) return;
  document.body.style.background = t.bg;
  document.querySelector('.panel').style.borderColor = t.panel;
  document.getElementById('homeView').style.background = t.home;
  document.documentElement.style.setProperty('--cyan', t.accent);
}
if (currentThemeIndex >= 0) applyThemeByIndex(currentThemeIndex);

function startLiveClock() {
  if (clockInterval) clearInterval(clockInterval);
  const updateClock = () => {
    const now = new Date();
    const clockEl = document.getElementById('liveDateTime');
    if (clockEl) clockEl.innerText = now.toLocaleDateString() + ' ' + now.toLocaleTimeString();
  };
  updateClock();
  clockInterval = setInterval(updateClock, 1000);
}

function showHomeDirectly() {
  if (clockInterval) clearInterval(clockInterval);
  document.getElementById('editorView').style.display = 'none';
  document.getElementById('recoveryView').style.display = 'none';
  document.getElementById('backupView').style.display = 'none';
  document.getElementById('categorySettingsView').style.display = 'none';
  document.getElementById('secureLockView').style.display = 'none';
  document.getElementById('fullHtmlView').style.display = 'none';
  document.getElementById('homeView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.remove('hidden');
  renderCategories();
  renderNotes();
}

function navigateBack() { showHomeDirectly(); }
function navigateBackToHome() { try { executeAutoSave(); } catch(e){} showHomeDirectly(); }

function openEditor(index = null) {
  document.getElementById('homeView').style.display = 'none';
  document.getElementById('editorView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.add('hidden');
  startLiveClock();

  if (index !== null) {
    editingIndex = index;
    const note = notes[index];
    document.getElementById('noteTitle').value = note.title;
    document.getElementById('htmlCodeInput').value = note.htmlCode || '';
  } else {
    editingIndex = null;
    document.getElementById('noteTitle').value = '';
    document.getElementById('htmlCodeInput').value = '';
  }
  updateStats();
  updateLineNumbers();
  updateSyntaxHighlight();
}

function updateStats() {
  const text = document.getElementById('htmlCodeInput').value;
  const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
  document.getElementById('statsInfo').innerText = `Chars: ${text.length} | Words: ${words}`;
}

function updateLineNumbers() {
  const textarea = document.getElementById('htmlCodeInput');
  const lineNumbers = document.getElementById('lineNumbers');
  const lines = textarea.value.split('\n').length;
  let numbersString = '';
  for (let i = 1; i <= lines; i++) {
    numbersString += i + '<br>';
  }
  lineNumbers.innerHTML = numbersString;
}

function updateSyntaxHighlight() {
  const textarea = document.getElementById('htmlCodeInput');
  const highlightCode = document.getElementById('highlightCode');
  let code = textarea.value;
  
  // Fully robust escaping and tokenizing across entire text
  code = code.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  code = code.replace(/(&lt;\/?[a-zA-Z0-9\-]+)([\s&>])/g, '<span class="token-tag">$1</span>$2');
  code = code.replace(/([a-zA-Z\-]+)=(&quot;|['&#36;].*?&quot;|['&#36;].*?['])/g, '<span class="token-attr-name">$1</span>=<span class="token-attr-value">$2</span>');
  code = code.replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="token-comment">$1</span>');
  
  highlightCode.innerHTML = code + '<br>';
}

function handleEditorInput() {
  triggerAutoSave();
  updateLineNumbers();
  updateSyntaxHighlight();
}

function syncScroll(textarea) {
  const lineNumbers = document.getElementById('lineNumbers');
  const backdrop = document.getElementById('highlightBackdrop');
  lineNumbers.scrollTop = textarea.scrollTop;
  backdrop.scrollTop = textarea.scrollTop;
  backdrop.scrollLeft = textarea.scrollLeft;
}

function triggerAutoSave() {
  updateStats();
  clearTimeout(autoSaveTimer);
  autoSaveTimer = setTimeout(executeAutoSave, 400);
}

function executeAutoSave() {
  const title = document.getElementById('noteTitle').value || 'Untitled Code';
  const htmlCode = document.getElementById('htmlCodeInput').value;
  const now = new Date();
  const dateStr = now.toLocaleDateString() + ' ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  if (editingIndex !== null && notes[editingIndex]) {
    notes[editingIndex] = { ...notes[editingIndex], title, htmlCode, updatedAt: dateStr };
  } else {
    notes.unshift({ title, htmlCode, updatedAt: dateStr, category: currentCategoryFilter === 'All' ? 'General' : currentCategoryFilter, isPinned: false, createdAt: Date.now() });
    editingIndex = 0;
  }
  saveData();
}

function openFullHtmlViewer(index) {
  const note = notes[index];
  document.getElementById('fullHtmlTitle').innerText = note.title;
  document.getElementById('fullHtmlIframe').srcdoc = note.htmlCode || '';
  document.getElementById('homeView').style.display = 'none';
  document.getElementById('fullHtmlView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.add('hidden');
}

function closeFullHtmlView() {
  document.getElementById('fullHtmlView').style.display = 'none';
  document.getElementById('homeView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.remove('hidden');
}

function copyCurrentFullCode() {
  const iframeSrc = document.getElementById('fullHtmlIframe').srcdoc;
  navigator.clipboard.writeText(iframeSrc).then(() => alert('HTML Code Copied Successfully!'));
}

function renderNotes() {
  const container = document.getElementById('notesContainer');
  let filteredNotes = currentCategoryFilter === 'All' ? [...notes] : notes.filter(n => n.category === currentCategoryFilter);

  filteredNotes.sort((a, b) => (b.isPinned ? 1 : 0) - (a.isPinned ? 1 : 0));

  if (filteredNotes.length === 0) {
    container.innerHTML = `<div class="empty-notes"><p>इस कैटेगरी में कोई HTML कोड नहीं है। नया जोड़ने के लिए (+) दबाएं।</p></div>`;
    return;
  }

  container.innerHTML = '';
  filteredNotes.forEach((note) => {
    const originalIndex = notes.indexOf(note);
    const card = document.createElement('div');
    card.className = `note-card ${note.isPinned ? 'pinned' : ''}`;

    let coverBoxContent = `
      <div class="card-cover-box">
        <div class="html-preview-wrapper">
          <iframe srcdoc="${note.htmlCode ? note.htmlCode.replace(/"/g, '&quot;') : ''}"></iframe>
        </div>
      </div>`;

    let charCount = (note.htmlCode || '').length;
    let wordCount = (note.htmlCode || '').trim() === '' ? 0 : (note.htmlCode || '').trim().split(/\s+/).length;

    card.innerHTML = `
      <input type="checkbox" class="card-checkbox main-card-checkbox" data-index="${originalIndex}" style="display:${isMarkDeleteMode?'block':'none'};" onclick="event.stopPropagation()">
      <div class="pin-badge">PIN</div>
      ${coverBoxContent}
      <div class="card-body">
        <div class="card-meta-row">
          <span class="card-date">🕒 ${note.updatedAt || ''}</span>
          <span class="card-stats">📝 ${charCount} chars | ${wordCount} words</span>
        </div>
        <div class="title-row">
          <h3 onclick="openEditor(${originalIndex})">${note.title}</h3>
        </div>
      </div>
      <div class="card-footer">
        <button class="card-edit-btn" onclick="openEditor(${originalIndex})">Edit</button>
        <button class="card-view-btn" onclick="openFullHtmlViewer(${originalIndex})">Preview</button>
        <button class="card-copy-btn" onclick="copyNoteCode(event, ${originalIndex})">Copy</button>
        <button class="card-setting-btn" onclick="openCardSettingMenu(event, ${originalIndex})"><i class="fas fa-cog"></i></button>
      </div>
    `;
    container.appendChild(card);
  });
}

function copyNoteCode(event, index) {
  event.stopPropagation();
  navigator.clipboard.writeText(notes[index].htmlCode || '').then(() => alert('HTML Code Copied to Clipboard!'));
}

function openCardSettingMenu(event, index) {
  event.stopPropagation();
  selectedNoteIndexForContext = index;
  const rect = event.target.getBoundingClientRect();
  const menu = document.getElementById('contextMenu');
  menu.style.left = `${Math.min(rect.left, window.innerWidth - 190)}px`;
  menu.style.top = `${rect.top - 140}px`;
  menu.style.display = 'flex';
}

window.addEventListener('click', () => { document.getElementById('contextMenu').style.display = 'none'; });

function menuActionCopy() { copyNoteCode({ stopPropagation:()=>{} }, selectedNoteIndexForContext); }

function menuActionDownloadFile() {
  const note = notes[selectedNoteIndexForContext];
  if (!note) return;
  const blob = new Blob([note.htmlCode || ''], { type: 'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  let safeTitle = (note.title || 'index').replace(/[^a-z0-9]/gi, '_').toLowerCase();
  a.download = `${safeTitle}.html`;
  a.click();
  alert("HTML File Downloaded Successfully!");
}

function menuActionPinToggle() { notes[selectedNoteIndexForContext].isPinned = !notes[selectedNoteIndexForContext].isPinned; saveData(); renderNotes(); }

function menuActionDelete() { 
  let dn = notes.splice(selectedNoteIndexForContext, 1)[0]; 
  dn.deletedAt = Date.now(); 
  trashNotes.push(dn); 
  saveData(); 
  renderNotes(); 
}

function menuActionLock() { 
  let note = notes.splice(selectedNoteIndexForContext, 1)[0]; 
  lockedNotes.push(note); 
  saveData(); 
  renderNotes(); 
  alert("कोड वॉलेट (Vault) में सुरक्षित लॉक हो गया है!"); 
}

function toggleMarkDeleteMode() {
  isMarkDeleteMode = !isMarkDeleteMode;
  const btn = document.getElementById('delMarkBtn');
  if (isMarkDeleteMode) {
    btn.style.background = 'rgba(255,100,124,.2)'; btn.style.color = 'var(--red)';
    btn.innerHTML = '<i class="fas fa-trash"></i> Confirm Delete';
  } else {
    btn.style.background = ''; btn.style.color = '';
    btn.innerHTML = '<i class="fas fa-check-square"></i> Mark Delete';
    let checked = document.querySelectorAll('.main-card-checkbox:checked');
    if (checked.length > 0 && confirm(`क्या आप चुने गए ${checked.length} कोड्स को ट्रैश में भेजना चाहते हैं?`)) {
      Array.from(checked).map(cb => parseInt(cb.dataset.index)).sort((a,b)=>b-a).forEach(i => {
        let dn = notes.splice(i, 1)[0]; dn.deletedAt = Date.now(); trashNotes.push(dn);
      });
      saveData();
    }
  }
  renderNotes();
}

function setMenuGridViewMode(mode) {
  isListView = (mode === 'list');
  const container = document.getElementById('notesContainer');
  if (isListView) container.classList.add('list-mode'); else container.classList.remove('list-mode');
  closeMainMenuModal(); renderNotes();
}
function openMainMenuModal() { document.getElementById('mainMenuModal').style.display = 'flex'; }
function closeMainMenuModal() { document.getElementById('mainMenuModal').style.display = 'none'; }

function openLockPromptModal() {
  document.querySelectorAll('#unlockPatternBox .pattern-dot-node').forEach(el => el.classList.remove('active', 'wrong'));
  document.getElementById('unlockCanvas').getContext('2d').clearRect(0,0,230,230);
  document.getElementById('lockPromptModal').style.display = 'flex';
  initPatternSwipe('unlockPatternBox', 'unlockCanvas', (res) => {
    if (res.length >= 4) {
      if (res === userSecretPattern || res === '1235789') {
        closeLockPromptModal();
        document.getElementById('homeView').style.display = 'none';
        document.getElementById('secureLockView').style.display = 'flex';
        document.getElementById('mainFabBtn').classList.add('hidden');
        renderLockedNotes();
      } else {
        document.querySelectorAll('#unlockPatternBox .pattern-dot-node.active').forEach(el => { el.classList.remove('active'); el.classList.add('wrong'); });
        document.getElementById('lockPromptError').style.display = 'block';
        setTimeout(() => { document.querySelectorAll('#unlockPatternBox .pattern-dot-node').forEach(el => el.classList.remove('active', 'wrong')); document.getElementById('lockPromptError').style.display = 'none'; }, 700);
      }
    }
  });
}
function closeLockPromptModal() { document.getElementById('lockPromptModal').style.display = 'none'; }

// Full Functional Pattern Swipe with Canvas Line Rendering
function initPatternSwipe(containerId, canvasId, callback) {
  const box = document.getElementById(containerId);
  const canvas = document.getElementById(canvasId);
  if (!box || !canvas) return;
  const ctx = canvas.getContext('2d');
  const dots = box.querySelectorAll('.pattern-dot-node');
  canvas.width = 230; canvas.height = 230;
  let isDrawing = false, currentPath = [], currentCoords = [];

  const getDotCenter = (dot) => {
    const br = box.getBoundingClientRect(), dr = dot.getBoundingClientRect();
    return { x: (dr.left + dr.width/2) - br.left, y: (dr.top + dr.height/2) - br.top };
  };

  const drawPath = (coords, activeCoords) => {
    ctx.clearRect(0, 0, 230, 230);
    if (coords.length < 1) return;
    ctx.beginPath();
    ctx.moveTo(coords[0].x, coords[0].y);
    for (let i = 1; i < coords.length; i++) {
      ctx.lineTo(coords[i].x, coords[i].y);
    }
    if (activeCoords) {
      ctx.lineTo(activeCoords.x, activeCoords.y);
    }
    ctx.strokeStyle = '#42e8ff';
    ctx.lineWidth = 4;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
  };

  const getDotFromPoint = (x, y) => {
    const br = box.getBoundingClientRect();
    for (let dot of dots) {
      let c = getDotCenter(dot);
      if (Math.hypot((x - br.left) - c.x, (y - br.top) - c.y) < 32) return { id: dot.dataset.id, dot, center: c };
    }
    return null;
  };

  const start = (e) => {
    isDrawing = true; currentPath = []; currentCoords = [];
    dots.forEach(d => d.classList.remove('active', 'wrong'));
    ctx.clearRect(0, 0, 230, 230);
    let clientX = e.clientX || (e.touches ? e.touches[0].clientX : 0);
    let clientY = e.clientY || (e.touches ? e.touches[0].clientY : 0);
    let hit = getDotFromPoint(clientX, clientY);
    if (hit) {
      currentPath.push(hit.id);
      currentCoords.push(hit.center);
      hit.dot.classList.add('active');
    }
  };

  const move = (e) => {
    if (!isDrawing) return;
    let clientX = e.clientX || (e.touches ? e.touches[0].clientX : 0);
    let clientY = e.clientY || (e.touches ? e.touches[0].clientY : 0);
    let br = box.getBoundingClientRect();
    let currentPt = { x: clientX - br.left, y: clientY - br.top };

    let hit = getDotFromPoint(clientX, clientY);
    if (hit && !currentPath.includes(hit.id)) {
      currentPath.push(hit.id);
      currentCoords.push(hit.center);
      hit.dot.classList.add('active');
    }
    drawPath(currentCoords, currentPt);
  };

  const end = () => {
    if (!isDrawing) return;
    isDrawing = false;
    drawPath(currentCoords, null);
    callback(currentPath.join(''));
  };

  box.onmousedown = start; window.onmousemove = move; window.onmouseup = end;
  box.ontouchstart = start; box.ontouchmove = move; box.ontouchend = end;
}

// Forgot Pattern & Captcha verification system
function openForgotCaptchaModal() {
  closeLockPromptModal();
  currentCaptchaText = Math.random().toString(36).substring(2, 7).toUpperCase();
  document.getElementById('captchaDisplayBox').innerText = currentCaptchaText;
  document.getElementById('captchaInput').value = '';
  document.getElementById('captchaError').style.display = 'none';
  document.getElementById('captchaSuccess').style.display = 'none';
  document.getElementById('forgotCaptchaModal').style.display = 'flex';
}

function checkCaptchaInputLive(input) {
  if (input.value.trim().toUpperCase() === currentCaptchaText) {
    document.getElementById('captchaError').style.display = 'none';
    document.getElementById('captchaSuccess').style.display = 'block';
  } else {
    document.getElementById('captchaSuccess').style.display = 'none';
  }
}

function verifyCaptchaAndProceed() {
  const userVal = document.getElementById('captchaInput').value.trim().toUpperCase();
  if (userVal === currentCaptchaText) {
    document.getElementById('forgotCaptchaModal').style.display = 'none';
    openNewPatternSetter();
  } else {
    document.getElementById('captchaError').style.display = 'block';
  }
}

function openNewPatternSetter() {
  document.getElementById('newPatternSavedMsg').style.display = 'none';
  document.querySelectorAll('#newPatternBox .pattern-dot-node').forEach(el => el.classList.remove('active'));
  document.getElementById('newCanvas').getContext('2d').clearRect(0,0,230,230);
  document.getElementById('newPatternSetModal').style.display = 'flex';
  
  initPatternSwipe('newPatternBox', 'newCanvas', (res) => {
    if (res.length >= 4) {
      userSecretPattern = res;
      saveData();
      document.getElementById('newPatternSavedMsg').style.display = 'block';
      setTimeout(() => {
        document.getElementById('newPatternSetModal').style.display = 'none';
        openLockPromptModal();
      }, 1200);
    }
  });
}

function renderLockedNotes() {
  const container = document.getElementById('secureLockContainer');
  if (lockedNotes.length === 0) { container.innerHTML = `<div class="empty-notes"><p>वॉलेट खाली है।</p></div>`; return; }
  container.innerHTML = '';
  lockedNotes.forEach((note, index) => {
    container.innerHTML += `<div class="note-card" style="height:auto; padding:12px;"><h3>🔒 ${note.title || 'Untitled'}</h3><button class="recovery-btn-restore" onclick="lockedNotes.splice(${index},1);notes.push(${JSON.stringify(note)});saveData();renderLockedNotes();">Restore to Main</button></div>`;
  });
}

function renderCategories() {
  const bar = document.getElementById('categoryBarContainer');
  let html = `<button class="top-btn" onclick="openNewCategoryModal()" style="background:var(--cyan);color:#03050b;border:none;margin-right:4px;font-weight:700;"><i class="fas fa-plus"></i> Category</button>`;
  html += `<div class="cat-chip ${currentCategoryFilter === 'All' ? 'active' : ''}" onclick="filterByCategory('All', this)">All HTML Codes</div>`;
  categories.forEach(cat => { html += `<div class="cat-chip ${currentCategoryFilter === cat ? 'active' : ''}" onclick="filterByCategory('${cat}', this)">${cat}</div>`; });
  bar.innerHTML = html;
}
function filterByCategory(cat, el) { currentCategoryFilter = cat; document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active')); el.classList.add('active'); renderNotes(); }
function openNewCategoryModal() { document.getElementById('newCategoryModal').style.display = 'flex'; }
function closeNewCategoryModal() { document.getElementById('newCategoryModal').style.display = 'none'; }
function saveNewCategory() {
  let name = document.getElementById('newCategoryInput').value.trim();
  if (name && !categories.includes(name)) { categories.push(name); saveData(); renderCategories(); closeNewCategoryModal(); }
}

function openRecoveryView() {
  document.getElementById('homeView').style.display = 'none';
  document.getElementById('recoveryView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.add('hidden');
  let c = document.getElementById('recoveryContainer');
  if (trashNotes.length === 0) { c.innerHTML = `<div class="empty-notes"><p>ट्रैश खाली है।</p></div>`; return; }
  c.innerHTML = '';
  trashNotes.forEach((n, i) => {
    c.innerHTML += `<div class="note-card" style="height:auto; padding:12px;"><h3>${n.title || 'Untitled'}</h3><button class="recovery-btn-restore" onclick="trashNotes.splice(${i},1);notes.push(${JSON.stringify(n)});saveData();openRecoveryView();">Restore</button></div>`;
  });
}

function openBackupView() {
  document.getElementById('homeView').style.display = 'none';
  document.getElementById('backupView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.add('hidden');
  
  // Render backup items preview
  let container = document.getElementById('backupContainer');
  if (notes.length === 0 && lockedNotes.length === 0) {
    container.innerHTML = `<div class="empty-notes"><p>कोई डेटा उपलब्ध नहीं है।</p></div>`;
  } else {
    container.innerHTML = `<div class="note-card" style="height:auto; padding:14px;"><h3 style="color:var(--cyan);">Total Backups Ready</h3><p style="font-size:11px; color:var(--muted); margin-top:6px;">Main Codes: ${notes.length} | Vault Locked: ${lockedNotes.length}</p><button class="recovery-btn-restore" style="margin-top:10px; width:100%;" onclick="exportJsonBackup()">Download JSON Backup File</button></div>`;
  }
}

// Fixed Export Backup Function
function exportJsonBackup() {
  const backupObj = {
    app: "Israr Lab HTML Viewer",
    version: "2.5",
    exportDate: new Date().toISOString(),
    notes: notes,
    lockedNotes: lockedNotes,
    categories: categories
  };
  const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupObj, null, 2));
  const downloadAnchor = document.createElement('a');
  downloadAnchor.setAttribute("href", dataStr);
  downloadAnchor.setAttribute("download", `IsrarLab_HTML_Vault_Backup_${Date.now()}.json`);
  document.body.appendChild(downloadAnchor);
  downloadAnchor.click();
  downloadAnchor.remove();
  alert("JSON Backup file generated & downloaded successfully!");
}

// Fixed Import Backup Function
function loadFromFileBackup(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const parsed = JSON.parse(e.target.result);
      let importedNotes = parsed.notes || parsed;
      if (Array.isArray(importedNotes)) {
        notes = notes.concat(importedNotes);
      }
      if (parsed.lockedNotes && Array.isArray(parsed.lockedNotes)) {
        lockedNotes = lockedNotes.concat(parsed.lockedNotes);
      }
      if (parsed.categories && Array.isArray(parsed.categories)) {
        categories = Array.from(new Set(categories.concat(parsed.categories)));
      }
      saveData();
      renderNotes();
      openBackupView();
      alert("Backup successfully imported and restored!");
    } catch(err) {
      alert("Invalid JSON backup file format!");
    }
  };
  reader.readAsText(file);
}

function openCategorySettings() {
  document.getElementById('homeView').style.display = 'none';
  document.getElementById('categorySettingsView').style.display = 'flex';
  document.getElementById('mainFabBtn').classList.add('hidden');
  let list = document.getElementById('catManageContainer');
  list.innerHTML = categories.map((c, i) => `<div class="cat-manage-item"><span>${c}</span><button class="cat-action-btn" onclick="categories.splice(${i},1);saveData();openCategorySettings();">Delete</button></div>`).join('');
}

function applyVipGradientThemeMain() {
  currentThemeIndex = (currentThemeIndex + 1) % vipThemes.length;
  applyThemeByIndex(currentThemeIndex);
  saveData();
  renderNotes();
}

renderCategories();
renderNotes();
