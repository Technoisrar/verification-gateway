<style>
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#03050b;
  --cyan:#42e8ff;
  --purple:#8c6cff;
  --green:#4ce3a8;
  --red:#ff647c;
  --text:#f5f8ff;
  --muted:#7f8ca3;
}
html{scroll-behavior:smooth;}
body{min-height:100vh;font-family:Inter,Arial,sans-serif;color:var(--text);background:radial-gradient(circle at 10% 0%,rgba(45,210,255,.12),transparent 28%),radial-gradient(circle at 90% 10%,rgba(125,76,255,.14),transparent 30%),radial-gradient(circle at 50% 100%,rgba(0,180,255,.06),transparent 35%),#03050b;overflow-x:hidden;}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:55px 55px;}

.wrapper{position:relative;z-index:2;width:min(900px,100%);margin:auto;padding:24px 16px 60px;}
.hero{text-align:center;padding:0 12px 20px;}
.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border-radius:50px;color:#72eaff;background:linear-gradient(135deg,rgba(55,220,255,.10),rgba(100,90,255,.06));border:1px solid rgba(72,222,255,.20);font-size:9px;font-weight:800;letter-spacing:1.7px;}
.badge i{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 7px var(--cyan),0 0 15px var(--cyan);animation:pulse 1.8s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(.7);}}
h1{margin-top:14px;font-size:26px;line-height:1.2;font-weight:700;letter-spacing:-1px;background:linear-gradient(110deg,#ffffff 15%,#b9f7ff 45%,#9e8cff 90%);-webkit-background-clip:text;background-clip:text;color:transparent;}

.panel{position:relative;padding:16px;border-radius:24px;background:linear-gradient(145deg,rgba(16,25,43,.92),rgba(5,9,17,.94));border:1px solid rgba(255,255,255,.09);box-shadow:0 40px 100px rgba(0,0,0,.55);backdrop-filter:blur(20px);}

#homeView{display:flex;flex-direction:column;min-height:580px;border-radius:16px;overflow:hidden;position:relative;background:#060d18;border:1px solid rgba(255,255,255,.08);}
.app-header{padding:10px;background:rgba(10,17,30,.95);border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;flex-shrink:0;}
.header-btn-row{display:flex;width:100%;gap:6px;align-items:center;flex-wrap:nowrap;}
.header-btn-row .hdr-btn{flex:1;min-width:0;height:32px;padding:0 6px;border-radius:8px;font-size:10px;cursor:pointer;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:4px;white-space:nowrap;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#c1cde0;transition:.2s;}
.header-btn-row .hdr-btn:hover{background:rgba(255,255,255,.1);color:#fff;}
.header-btn-row .hdr-btn.theme-btn{background:rgba(66,232,255,.12);border-color:rgba(66,232,255,.3);color:var(--cyan);}
.header-btn-row .hdr-btn.lock-btn{background:rgba(66,232,255,.1);border-color:rgba(66,232,255,.25);color:var(--cyan);}

.top-action-bar{background:rgba(8,14,26,.9);border-bottom:1px solid rgba(255,255,255,.07);padding:10px 12px;display:flex;gap:8px;overflow-x:auto;white-space:nowrap;scrollbar-width:none;flex-shrink:0;}
.top-action-bar::-webkit-scrollbar{display:none;}
.top-btn{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);height:34px;padding:0 14px;border-radius:8px;font-size:11px;cursor:pointer;font-weight:600;color:#c1cde0;display:inline-flex;align-items:center;justify-content:center;gap:6px;transition:.2s;}
.top-btn:hover{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.2);}

.category-bar-wrapper{background:rgba(8,14,26,.6);border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;position:relative;padding:8px 12px;flex-shrink:0;}
.category-scroll-area{display:flex;gap:8px;overflow-x:auto;white-space:nowrap;align-items:center;flex:1;padding-right:40px;scrollbar-width:none;}
.category-scroll-area::-webkit-scrollbar{display:none;}
.cat-chip{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);height:30px;padding:0 14px;border-radius:15px;font-size:11px;cursor:pointer;color:#a3b2c9;font-weight:500;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s;}
.cat-chip.active{background:var(--cyan);color:#03050b;border-color:var(--cyan);font-weight:700;box-shadow:0 0 12px rgba(66,232,255,.4);}

/* Notes Container Grid & List mode */
.notes-container{flex:1;padding:12px;overflow-y:auto;display:grid;grid-template-columns:repeat(2,1fr);gap:14px;align-content:start;max-height:680px;}
.notes-container.list-mode{grid-template-columns:1fr !important;}
.empty-notes{grid-column:1 / -1;display:flex;flex-direction:column;align-items:center;justify-content:center;height:30vh;color:#65738a;font-size:12px;text-align:center;}

.note-card{background:rgba(12,20,35,0.95);border-radius:14px;border:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;transition:.2s ease;height:330px;}
.notes-container.list-mode .note-card{height:350px;}
.note-card:hover{transform:translateY(-2px);border-color:rgba(66,232,255,.3);box-shadow:0 8px 25px rgba(0,0,0,.4);}

.card-cover-box{width:100%;height:165px;background:#ffffff;position:relative;overflow:hidden;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,.06);}
.html-preview-wrapper{width:200%;height:200%;transform:scale(0.5);transform-origin:0 0;pointer-events:auto;background:#ffffff;}
.html-preview-wrapper iframe{width:100%;height:100%;border:none;background:#ffffff;}

.card-body{padding:8px 10px;display:flex;flex-direction:column;gap:3px;flex:1;overflow:hidden;}
.card-meta-row{display:flex;justify-content:space-between;align-items:center;font-size:9px;}
.card-date{color:var(--cyan);font-weight:600;}
.card-stats{color:#65738a;font-weight:600;}

.title-row{display:flex;justify-content:space-between;align-items:center;gap:6px;}
.note-card h3{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;}

.card-footer{padding:6px 8px;background:rgba(6,11,20,.95);border-top:1px solid rgba(255,255,255,.06);display:flex;justify-content:space-between;align-items:center;gap:3px;flex-shrink:0;}
.card-footer button{flex:1;height:26px;font-size:8.5px;border-radius:5px;cursor:pointer;font-weight:700;border:none;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;transition:.2s;padding:0 2px;}
.card-edit-btn{background:rgba(76,227,168,.15);color:var(--green);border:1px solid rgba(76,227,168,.3) !important;}
.card-view-btn{background:rgba(140,108,255,.15);color:#b3a1ff;border:1px solid rgba(140,108,255,.3) !important;}
.card-copy-btn{background:rgba(66,232,255,.15);color:var(--cyan);border:1px solid rgba(66,232,255,.3) !important;}
.card-setting-btn{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.15) !important;flex:0.7 !important;}
.card-checkbox{position:absolute;top:8px;right:8px;width:16px;height:16px;display:none;z-index:5;cursor:pointer;accent-color:var(--cyan);}
.pin-badge{position:absolute;top:8px;left:8px;background:#f59e0b;color:#000;font-size:8px;padding:2px 5px;border-radius:4px;font-weight:800;z-index:5;display:none;}
.note-card.pinned .pin-badge{display:block;}

/* FAB */
.fab{position:absolute;bottom:16px;right:16px;width:52px;height:52px;background:linear-gradient(135deg,var(--cyan),var(--purple));color:#03050b;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 6px 20px rgba(66,232,255,.45);cursor:pointer;border:none;z-index:20;transition:.2s;}
.fab:hover{transform:scale(1.08);box-shadow:0 8px 25px rgba(66,232,255,.65);}
.fab.hidden{display:none !important;}

/* Full Screen SubViews & Modals */
#backupView, #categorySettingsView, #recoveryView, #editorView, #secureLockView, #fullHtmlView {
  display:none;flex-direction:column;position:fixed;top:0;left:0;width:100vw;height:100vh;background:#03050b;z-index:2000;
}
.recovery-header, .editor-top-bar, .backup-controls{padding:14px 20px;background:rgba(6,11,20,.95);border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center;}
.cat-manage-list{flex:1;padding:20px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;}
.cat-manage-item{background:rgba(16,25,43,.9);padding:14px 18px;border:1px solid rgba(255,255,255,.08);border-radius:10px;display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:600;}
.cat-action-btn{background:rgba(255,100,124,.15);color:var(--red);border:1px solid rgba(255,100,124,.3);padding:6px 12px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:700;}
.recovery-btn-restore{background:rgba(76,227,168,.2);color:var(--green);border:1px solid rgba(76,227,168,.4);padding:8px 16px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;}

/* Dialogs & Fixed Layout for Lock Modal */
#lockPromptModal, #newCategoryModal, #mainMenuModal, #forgotCaptchaModal, #newPatternSetModal {
  position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(3,5,11,0.85);display:none;justify-content:center;align-items:center;z-index:3000;backdrop-filter:blur(8px);
}
.modal-content{background:rgba(14,22,38,0.98);padding:24px;border-radius:20px;width:320px;display:flex;flex-direction:column;gap:14px;border:1px solid rgba(255,255,255,.12);box-shadow:0 20px 50px rgba(0,0,0,.6);align-items:center;}
.modal-title{font-size:15px;font-weight:700;color:#fff;text-align:center;}
.modal-input{width:100%;padding:12px;font-size:13px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:#060d18;color:#fff;outline:none;text-align:center;}
.error-alert{color:var(--red);font-size:11px;font-weight:600;text-align:center;display:none;}
.success-alert{color:var(--green);font-size:11px;font-weight:600;text-align:center;display:none;}
.modal-btn-group{display:flex;gap:10px;width:100%;margin-top:6px;}
.modal-btn-cancel, .modal-btn-save{background:rgba(255,255,255,.06);color:#fff;border:1px solid rgba(255,255,255,.12);padding:10px;border-radius:8px;font-size:12px;cursor:pointer;font-weight:700;flex:1;text-align:center;transition:.2s;}
.modal-btn-save{background:linear-gradient(110deg,#4ce3a8,#1ecb88);color:#02110c;border:none;}

/* Pattern Grid */
.pattern-grid-box{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;width:230px;height:230px;background:#060d18;padding:20px;border-radius:16px;border:1px solid rgba(255,255,255,.1);margin:6px auto;position:relative;justify-items:center;align-items:center;touch-action:none;user-select:none;}
.pattern-canvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:2;}
.pattern-dot-node{width:42px;height:42px;border-radius:50%;background:#101a2e;border:2px solid rgba(255,255,255,.15);cursor:pointer;position:relative;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:3;transition:.2s;}
.pattern-dot-node::after{content:'';width:12px;height:12px;background:var(--cyan);border-radius:50%;box-shadow:0 0 8px var(--cyan);display:block;}
.pattern-dot-node.active{border-color:var(--green);background:rgba(76,227,168,.2);}
.pattern-dot-node.active::after{background:var(--green);box-shadow:0 0 12px var(--green);}
.pattern-dot-node.wrong{border-color:var(--red);background:rgba(255,100,124,.2);}
.pattern-dot-node.wrong::after{background:var(--red);box-shadow:0 0 12px var(--red);}
.modal-cat-item{padding:10px 14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;cursor:pointer;font-size:12px;color:#fff;text-align:center;width:100%;font-weight:600;transition:.2s;}
.modal-cat-item:hover{background:var(--cyan);color:#03050b;}

/* Context Menu */
.context-menu{position:fixed;background:rgba(14,22,38,0.98);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.5);display:none;flex-direction:column;width:180px;z-index:2500;border:1px solid rgba(255,255,255,.12);overflow:hidden;}
.context-menu-item{padding:10px 14px;font-size:11px;color:#fff;cursor:pointer;border-bottom:1px solid rgba(255,255,255,.06);font-weight:600;}
.context-menu-item:hover{background:rgba(66,232,255,.15);color:var(--cyan);}
.context-menu-item.delete-option{color:var(--red);}

/* Editor View with Full Syntax Highlighting */
.stats-info{font-size:10px;color:var(--muted);background:rgba(255,255,255,.04);padding:4px 10px;border-radius:6px;border:1px solid rgba(255,255,255,.08);white-space:nowrap;}
.editor-center-meta{display:flex;align-items:center;gap:12px;justify-content:center;flex:1;}
.autosave-indicator{font-size:10px;color:var(--green);font-weight:700;display:flex;align-items:center;gap:4px;white-space:nowrap;}
.live-datetime{font-size:10px;color:var(--muted);font-weight:600;white-space:nowrap;}
.editor-body{flex:1;padding:16px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;position:relative;}
.title-input{width:100%;font-size:18px;font-weight:700;border:none;border-bottom:2px solid rgba(255,255,255,.1);padding:8px 0;outline:none;background:transparent;color:#fff;}

/* Code editor container layout */
.code-editor-wrapper{display:flex; flex:1; background:#040810; border:1px solid rgba(255,255,255,0.1); border-radius:8px; overflow:hidden; min-height:350px; position:relative;}
.line-numbers{width:38px; background:#02050a; color:#4a5568; font-family:monospace; font-size:12px; padding-top:12px; text-align:right; padding-right:8px; user-select:none; line-height:1.6; z-index:3;}
.editor-input-area{position:relative; flex:1; height:100%; overflow:hidden;}
.content-textarea, .highlight-backdrop{position:absolute; top:0; left:0; width:100%; height:100%; font-size:13px; line-height:1.6; padding:12px; font-family:monospace; white-space:pre-wrap; word-break:break-all; overflow-wrap:break-word;}
.content-textarea{border:none; outline:none; resize:none; background:transparent; color:transparent; caret-color:#4ce3a8; z-index:2; overflow-y:auto;}
.highlight-backdrop{background:transparent; color:#c1cde0; pointer-events:none; z-index:1; overflow:hidden;}

/* Syntax Highlighting Custom Colors */
.token-tag { color: #ff79c6; font-weight: bold; }
.token-attr-name { color: #50fa7b; }
.token-attr-value { color: #f1fa8c; }
.token-comment { color: #6272a4; font-style: italic; }
.token-keyword { color: #8be9fd; font-weight: bold; }

/* Footer */
.main-footer{margin-top:40px;padding:35px 16px;text-align:center;border-top:1px solid rgba(255,255,255,.08);background:rgba(3,7,15,.95);}
.footer-links{margin-bottom:16px;display:flex;flex-wrap:wrap;justify-content:center;gap:14px 28px;font-size:13px;font-weight:600;}
.footer-links a{color:#9aa8bc;text-decoration:none;transition:.2s;}
.footer-links a:hover{color:var(--cyan);}
.footer-copyright{font-size:10px;color:#5a687d;}

@media(max-width:640px){
  .wrapper{padding:16px 8px 40px;}
  h1{font-size:22px;}
  .notes-container{grid-template-columns:repeat(2,1fr) !important;gap:10px;max-height:560px;}
  .panel{padding:10px;border-radius:18px;}
  .fab{bottom:12px;right:12px;width:48px;height:48px;font-size:24px;}
  .note-card{height:310px;}
}
</style>
